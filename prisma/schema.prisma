generator client {
  provider = "prisma-client-js"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
  // TEMPORARY FIX: Use the actual URL to force validation success
  url      = "postgresql://deborah_listens_db_user:qPLSUz6tQldY5vOWfOIRLuLi1ZG51EpK@dpg-d3t2g4buibrs73amg0jg-a.oregon-postgres.render.com/deborah_listens_db?sslmode=require"
}

model Admin {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String   // hashed password
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Booking {
  id            String   @id @default(cuid())
  name          String
  email         String
  phone         String?
  message       String
  status        String   @default("pending") // pending, confirmed, cancelled
  adminNotes    String?
  confirmedAt   DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([status])
  @@index([email])
  @@index([createdAt])
}
